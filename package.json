{
  "name": "@anthony-dius/clarity",
  "version": "0.1.0",
  "description": "Standalone ASD-STE100 CLI documentation checker",
  "type": "module",
  "license": "MIT",
  "author": "Anthony Roy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthony-dius/clarity.git"
  },
  "homepage": "https://github.com/anthony-dius/clarity#readme",
  "bugs": "https://github.com/anthony-dius/clarity/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clarity": "./bin/clarity.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun build --compile ./src/cli/index.ts --outfile ./dist/clarity",
    "build:npm": "bun build ./src/cli/index.ts --outfile ./bin/clarity.js --target node --banner '#!/usr/bin/env node'"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.1",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "ts-morph": "^28.0.0"
  }
}
